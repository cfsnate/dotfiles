#!/bin/bash
# Provision Homebrew packages. Plain run_ script, so it executes on every
# `chezmoi apply`: refreshes Homebrew, upgrades installed packages, and installs
# any tracked packages that are missing.

# On first run brew isn't on PATH yet (its shellenv is loaded by new login
# shells, not this script). Locate it for Apple Silicon or Intel and load it.
if ! command -v brew >/dev/null 2>&1; then
    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$brew_path" ]; then
            eval "$("$brew_path" shellenv)"
            break
        fi
    done
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "brew not found on PATH; cannot install packages." >&2
    exit 1
fi

# Refresh Homebrew and upgrade everything already installed before reconciling
# the tracked list below. Failures here are non-fatal so the apply continues.
echo "==> Refreshing Homebrew (brew update)"
brew update || echo "⚠️  brew update failed; continuing." >&2
echo "==> Upgrading installed packages (brew upgrade)"
brew upgrade || echo "⚠️  brew upgrade failed; continuing." >&2

# NOTE: `brew bundle` is fail-fast: one bad entry (e.g. the 1password cask's
# checksum mismatch, or a cask needing manual approval) aborts the whole run and
# skips every package after it. Install per entry instead so a single failure
# can't block the other ~126 packages. Skip already-installed items (the upgrade
# above already handles updating them), collect failures, report them, and exit 0
# so the rest of the chezmoi apply proceeds.

taps=(
{{ range .packages.brews.tap }}    {{ . | quote }}
{{ end }})
formulae=(
{{ range .packages.brews.formulae }}    {{ . | quote }}
{{ end }})
casks=(
{{ range .packages.brews.casks }}    {{ . | quote }}
{{ end }})

failed=()

# Casks that run privileged (sudo) installers authenticate via Touch ID, enabled
# earlier by run_once_before_enable-touchid-sudo. That works in chezmoi's
# TTY-less context where a password prompt would fail with "unable to read
# password: Input/output error".

echo "==> Reconciling ${#taps[@]} tap(s)"
for t in "${taps[@]}"; do
    echo "  - $t"
    brew tap "$t" || failed+=("tap $t")
done

# Snapshot installed formulae/casks once rather than spawning `brew list` per
# entry (~130 brew invocations, the slow part of a no-op apply). macOS /bin/bash
# is 3.2 (no associative arrays), so match with grep against the captured lists.
# Match on the bare name: brew lists tap-qualified formulae by their last path
# component (hashicorp/tap/packer -> packer), so normalize lookups with ${f##*/}.
installed_formulae="$(brew list --formula -1 2>/dev/null)"
installed_casks="$(brew list --cask -1 2>/dev/null)"

echo "==> Reconciling ${#formulae[@]} formula(e)"
for f in "${formulae[@]}"; do
    grep -qxF "${f##*/}" <<< "$installed_formulae" && continue
    echo "  ⤓ installing $f"
    brew install --formula "$f" || failed+=("brew $f")
done

echo "==> Reconciling ${#casks[@]} cask(s)"
for c in "${casks[@]}"; do
    grep -qxF "${c##*/}" <<< "$installed_casks" && continue
    echo "  ⤓ installing $c"
    brew install --cask "$c" || failed+=("cask $c")
done

if [ ${#failed[@]} -gt 0 ]; then
    echo >&2
    echo "⚠️  ${#failed[@]} Homebrew item(s) failed to install:" >&2
    printf '   - %s\n' "${failed[@]}" >&2
    echo "   Retry an individual item, e.g.: brew install --cask 1password" >&2
fi

# Tidy up after reconciling: drop unused dependencies, then prune old versions
# and stale download caches. Both are non-fatal so the apply still finishes.
echo "==> Removing unused dependencies (brew autoremove)"
brew autoremove || echo "⚠️  brew autoremove failed; continuing." >&2
echo "==> Pruning old versions and caches (brew cleanup)"
brew cleanup || echo "⚠️  brew cleanup failed; continuing." >&2
